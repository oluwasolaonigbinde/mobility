# Copy this file to a root-readable path outside the repository and replace
# every EXAMPLE-ONLY value before rendering the production Compose model.

# Public hostname accepted by Caddy. This reserved domain is not deployable.
EDGE_HOSTNAME=staging.invalid

# Postgres container password and matching async application URL.
POSTGRES_PASSWORD=EXAMPLE-ONLY-REPLACE-POSTGRES-PASSWORD
DATABASE_URL=postgresql+asyncpg://mobility:EXAMPLE-ONLY-REPLACE-POSTGRES-PASSWORD@db:5432/mobility

# Redis password and matching authenticated application URL.
REDIS_PASSWORD=EXAMPLE-ONLY-REPLACE-REDIS-PASSWORD
REDIS_URL=redis://:EXAMPLE-ONLY-REPLACE-REDIS-PASSWORD@redis:6379/0

# At least 32 random bytes in a real environment. Never reuse this example.
JWT_SECRET_KEY=EXAMPLE-ONLY-REPLACE-WITH-AT-LEAST-32-RANDOM-BYTES

# Versioned AES-256 KEKs for protected payout account data. This deterministic
# example is for Compose rendering only; replace it with generated secret data.
PAYOUT_CRYPTO_KEYRING_B64={"1":"AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8="}
PAYOUT_CRYPTO_KEY_VERSION=1

# Optional server DSN, read only at runtime. Blank keeps server Sentry inert.
SENTRY_DSN=

# Optional browser DSN, embedded only while building the frontend image.
NEXT_PUBLIC_SENTRY_DSN=

# External gate reference for the verified legal invoice issuer. Keep blank
# until EXT-Q28-COMPANY is resolved; blank keeps invoice issuance disabled.
INVOICE_ISSUER_EXTERNAL_INPUT_REFERENCE=

# Trusted client-IP mode is deliberately disabled. Enable all three settings
# only after proving Caddy is the sole public path, its accepted socket peer is
# the real client, and this deployment's exact BFF peer CIDR is known. If any
# direct frontend/API path or provider proxy is reachable, keep these defaults.
LOGIN_RATE_LIMIT_RELAY_CLIENT_IP_HEADER=false
LOGIN_RATE_LIMIT_TRUST_CLIENT_IP_HEADER=false
LOGIN_RATE_LIMIT_TRUSTED_PROXY_CIDRS=

# Worker settings. The worker is a required service (payout_v2 pipeline +
# S4 data lifecycle); its compose profile exists only for operational
# quiescing. Start it in every release: --profile worker up -d worker.
WORKER_SWEEP_INTERVAL_MINUTES=5
FRAUD_ASSESSMENT_FORMULA_VERSION=fraud_assessment_v1
ROUTE_REPLAY_DETECTOR_VERSION=route_replay_v1
ROUTE_REPLAY_COORDINATE_PRECISION=5
ROUTE_REPLAY_TIME_TOLERANCE_SECONDS=5
ROUTE_REPLAY_MIN_VALID_PINGS=10
ROUTE_REPLAY_MIN_DISTANCE_M=250
ROUTE_REPLAY_MAX_EVIDENCE_MATCHES=10
WORKER_SWEEP_BATCH_SIZE=25
PING_RETENTION_MONTHS=12
PARTITION_PREMAKE_MONTHS=4

# Privacy disclosure remains fail-closed. These numeric values are synthetic
# build parameters only; do not enable until legal, density and retention
# evidence has supplied approved non-placeholder references.
PRIVACY_DISCLOSURE_LIVE_AUTHORIZED=false
PRIVACY_LEGAL_APPROVAL_REFERENCE=
PRIVACY_DISCLOSURE_CONFIG_REFERENCE=
PRIVACY_QUERY_HISTORY_RETENTION_REFERENCE=
PRIVACY_QUERY_HISTORY_RETENTION_DAYS=30
PRIVACY_MIN_VEHICLES_PER_CELL=3
PRIVACY_MIN_TRIPS_PER_CELL=5
PRIVACY_MIN_DAYS_PER_CELL=2
PRIVACY_MAX_CONTRIBUTOR_SHARE=0.5
PRIVACY_MIN_RESOLUTION_M=500
