# Copy this file to a root-readable path outside the repository and replace
# every EXAMPLE-ONLY value before rendering the production Compose model.

# Public hostname accepted by Caddy. This reserved domain is not deployable.
EDGE_HOSTNAME=staging.invalid
ENVIRONMENT=staging
RELEASE_ID=20260902T120000Z-REPLACE-ME
RELEASE_REVISION=0000000000000000000000000000000000000000
PREVIOUS_RELEASE_ID=
BACKEND_IMAGE=registry.invalid/cardvert/backend@sha256:1111111111111111111111111111111111111111111111111111111111111111
FRONTEND_IMAGE=registry.invalid/cardvert/frontend@sha256:2222222222222222222222222222222222222222222222222222222222222222
POSTGIS_IMAGE=postgis/postgis@sha256:3333333333333333333333333333333333333333333333333333333333333333
REDIS_IMAGE=redis@sha256:4444444444444444444444444444444444444444444444444444444444444444
CADDY_IMAGE=caddy@sha256:5555555555555555555555555555555555555555555555555555555555555555
PUBLIC_ORIGIN=https://staging.invalid
BACKEND_CORS_ORIGINS=[]
SESSION_COOKIE_NAME=__Host-cardvert_session

# Postgres container password and matching async application URL.
POSTGRES_PASSWORD=EXAMPLE-ONLY-REPLACE-POSTGRES-PASSWORD
POSTGRES_TLS_CA_FILE=/secure/REPLACE-ME-postgres-ca.crt
POSTGRES_TLS_CERT_FILE=/secure/REPLACE-ME-postgres-server.crt
POSTGRES_TLS_KEY_FILE=/secure/REPLACE-ME-postgres-server.key
DATABASE_URL=postgresql+asyncpg://mobility:EXAMPLE-ONLY-REPLACE-POSTGRES-PASSWORD@db:5432/mobility?ssl=verify-full

# Redis password and matching authenticated application URL.
REDIS_PASSWORD=EXAMPLE-ONLY-REPLACE-REDIS-PASSWORD
REDIS_TLS_CA_FILE=/secure/REPLACE-ME-redis-ca.crt
REDIS_TLS_CERT_FILE=/secure/REPLACE-ME-redis-server.crt
REDIS_TLS_KEY_FILE=/secure/REPLACE-ME-redis-server.key
REDIS_URL=rediss://:EXAMPLE-ONLY-REPLACE-REDIS-PASSWORD@redis:6379/0?ssl_ca_certs=/run/secrets/redis_tls_ca&ssl_cert_reqs=required

# At least 32 random bytes in a real environment. Never reuse this example.
JWT_SECRET_KEY=EXAMPLE-ONLY-REPLACE-WITH-AT-LEAST-32-RANDOM-BYTES

# Versioned AES-256 KEKs for protected payout account data. This deterministic
# example is for Compose rendering only; replace it with generated secret data.
PAYOUT_CRYPTO_KEYRING_B64={"1":"AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8="}
PAYOUT_CRYPTO_KEY_VERSION=1
TRIP_EVIDENCE_SIGNING_KEYRING_B64=EXAMPLE-ONLY-REPLACE-WITH-A-JSON-BASE64-KEYRING
TRIP_EVIDENCE_SIGNING_KEY_VERSION=1

# Optional server DSN, read only at runtime. Blank keeps server Sentry inert.
SENTRY_DSN=

# Optional browser DSN, embedded only while building the frontend image.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_MAP_STYLE_URL=EXAMPLE-ONLY-REPLACE-WITH-APPROVED-HTTPS-MAP-STYLE-URL

# External gate reference for the verified legal invoice issuer. Keep blank
# until EXT-Q28-COMPANY is resolved; blank keeps invoice issuance disabled.
INVOICE_ISSUER_EXTERNAL_INPUT_REFERENCE=

# Trusted client-IP mode is deliberately disabled. Enable all three settings
# only after proving Caddy is the sole public path, its accepted socket peer is
# the real client, and this deployment's exact BFF peer CIDR is known. If any
# direct frontend/API path or provider proxy is reachable, keep these defaults.
LOGIN_RATE_LIMIT_RELAY_CLIENT_IP_HEADER=false
LOGIN_RATE_LIMIT_TRUST_CLIENT_IP_HEADER=false
LOGIN_RATE_LIMIT_TRUSTED_PROXY_CIDRS=
DRIVER_REGISTRATION_ENABLED=false
DRIVER_REGISTRATION_RATE_LIMIT_IP_MAX_ATTEMPTS=10
DRIVER_REGISTRATION_RATE_LIMIT_IP_WINDOW_SECONDS=3600
DRIVER_REGISTRATION_RATE_LIMIT_EMAIL_MAX_ATTEMPTS=3
DRIVER_REGISTRATION_RATE_LIMIT_EMAIL_WINDOW_SECONDS=3600
DRIVER_REGISTRATION_RATE_LIMIT_TRUST_CLIENT_IP_HEADER=false
DRIVER_REGISTRATION_RATE_LIMIT_TRUSTED_PROXY_CIDRS=

# Worker settings. The worker is a required service (payout_v2 pipeline +
# S4 data lifecycle); its compose profile exists only for operational
# quiescing. Start it in every release: --profile worker up -d worker.
WORKER_SWEEP_INTERVAL_MINUTES=5
FRAUD_ASSESSMENT_FORMULA_VERSION=fraud_assessment_v1
ROUTE_REPLAY_DETECTOR_VERSION=route_replay_v1
ROUTE_REPLAY_COORDINATE_PRECISION=5
ROUTE_REPLAY_TIME_TOLERANCE_SECONDS=5
ROUTE_REPLAY_MIN_VALID_PINGS=10
ROUTE_REPLAY_MIN_DISTANCE_M=250
ROUTE_REPLAY_MAX_EVIDENCE_MATCHES=10
WORKER_SWEEP_BATCH_SIZE=25
# Q17 production policy remains unset until approved. The high-earner renewal
# worker reports missing configuration without inventing live thresholds.
EVIDENCE_HIGH_EARNER_THRESHOLD_NGN=
EVIDENCE_RENEWAL_LOOKBACK_DAYS=
EVIDENCE_CHALLENGE_RESPONSE_HOURS=
# EXT-EMAIL-PROVIDER remains unresolved. Blank values keep live dispatch and
# receipt acceptance disabled until a provider and verified sender are supplied.
EMAIL_PROVIDER=
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_NAME=Cardvert
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_STARTTLS=false
EMAIL_RECEIPT_SIGNING_SECRET=
EMAIL_RECEIPT_KEY_ID=
# Keep these live-use gates disabled/blank until the named external inputs exist.
BUDGET_POLICY_EXTERNAL_APPROVED=false
BUDGET_POLICY_ID=
BUDGET_POLICY_REVISION=
BUDGET_ALERT_RATIO=
BUDGET_PAUSE_RATIO=
BUDGET_RESUME_RATIO=
PHONE_OPERATOR_EXTERNAL_APPROVED=false
PASSWORD_RESET_PUBLIC_URL=
PING_RETENTION_MONTHS=12
PARTITION_PREMAKE_MONTHS=4

# Privacy disclosure remains fail-closed. These numeric values are synthetic
# build parameters only; do not enable until legal, density and retention
# evidence has supplied approved non-placeholder references.
PRIVACY_DISCLOSURE_LIVE_AUTHORIZED=false
MEASUREMENT_LIVE_ISSUANCE_AUTHORIZED=false
MEASUREMENT_REPORT_METHOD_REFERENCE=
MEASUREMENT_ROI_METHOD_REFERENCE=
PRIVACY_LEGAL_APPROVAL_REFERENCE=
PRIVACY_DISCLOSURE_CONFIG_REFERENCE=
PRIVACY_QUERY_HISTORY_RETENTION_REFERENCE=
PRIVACY_QUERY_HISTORY_RETENTION_DAYS=30
PRIVACY_MIN_VEHICLES_PER_CELL=3
PRIVACY_MIN_TRIPS_PER_CELL=5
PRIVACY_MIN_DAYS_PER_CELL=2
PRIVACY_MAX_CONTRIBUTOR_SHARE=0.5
PRIVACY_MIN_RESOLUTION_M=500
DSR_APPROVED_EXCEPTION_REFERENCES=

# All application settings used by the production topology are explicit. These
# values remain examples and do not grant staging or provider authority.
APP_NAME=cardvert-api
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_FORMAT=json
REQUEST_ID_HEADER=X-Request-ID
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_ABSOLUTE_LIFETIME_MINUTES=720
PASSWORD_MIN_LENGTH=12
DEFAULT_CURRENCY=NGN
ALLOW_DEMO_SEED=false
DEMO_LOGIN_ENABLED=false
PRIVACY_DISCLOSURE_SYNTHETIC_TEST_MODE=false
PRIVACY_COLLECTION_SYNTHETIC_TEST_MODE=false
PRIVACY_COLLECTION_LIVE_AUTHORIZED=false
DRIVER_ONBOARDING_ACCESS_TTL_SECONDS=1800
LOGIN_RATE_LIMIT_IP_MAX_FAILURES=150
LOGIN_RATE_LIMIT_IP_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_ACCOUNT_MAX_FAILURES=5
LOGIN_RATE_LIMIT_ACCOUNT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_GLOBAL_MAX_FAILURES=250
LOGIN_RATE_LIMIT_GLOBAL_WINDOW_SECONDS=300
F7_SEED_MAX_TRIPS_PER_DAY=2

OBJECT_STORAGE_ENDPOINT_URL=https://objects.invalid
OBJECT_STORAGE_PUBLIC_ENDPOINT_URL=https://objects.invalid
OBJECT_STORAGE_REGION=EXAMPLE-ONLY-REPLACE-REGION
OBJECT_STORAGE_BUCKET=EXAMPLE-ONLY-REPLACE-PRIVATE-BUCKET
OBJECT_STORAGE_ACCESS_KEY_ID=EXAMPLE-ONLY-REPLACE-ACCESS-KEY
OBJECT_STORAGE_SECRET_ACCESS_KEY=EXAMPLE-ONLY-REPLACE-WITH-A-LONG-SECRET
OBJECT_STORAGE_PRESIGN_TTL_SECONDS=300
OBJECT_STORAGE_ORPHAN_TTL_HOURS=24
OBJECT_STORAGE_DOWNLOAD_TTL_SECONDS=60
MALWARE_SCANNER_HOST=EXAMPLE-ONLY-REPLACE-SCANNER-HOST
MALWARE_SCANNER_PORT=3310
