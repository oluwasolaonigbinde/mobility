{$EDGE_HOSTNAME} {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
	log_append request_id {http.request.uuid}
	log_append request_path {http.request.uri.path}
	log_append release_revision {$RELEASE_REVISION:unbound}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), xr-spatial-tracking=(), geolocation=(self), screen-wake-lock=(self), clipboard-write=(self)"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; frame-src 'none'; upgrade-insecure-requests"
		-Server
	}

	@public_api path /health /api/v1/health* /api/v1/webhooks/*
	handle @public_api {
		reverse_proxy api:8000 {
			header_up -Forwarded
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -X-Real-IP
			header_up -CF-Connecting-IP
			header_up -True-Client-IP
			header_up -Fly-Client-IP
			header_up -X-Azure-ClientIP
			header_up -X-Envoy-External-Address
			header_up X-Client-IP {http.request.remote.host}
			header_up X-Request-ID {http.request.uuid}
		}
	}

	handle {
		reverse_proxy frontend:3000 {
			header_up -Forwarded
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -X-Real-IP
			header_up -CF-Connecting-IP
			header_up -True-Client-IP
			header_up -Fly-Client-IP
			header_up -X-Azure-ClientIP
			header_up -X-Envoy-External-Address
			header_up X-Client-IP {http.request.remote.host}
			header_up X-Request-ID {http.request.uuid}
		}
	}
}
