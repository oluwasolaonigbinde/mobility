# Hetzner Compose template (D44/D62). Secrets are blank; no region selected.
# DATABASE_URL: postgresql+asyncpg with ssl=verify-full and the supplied CA.
# REDIS_URL: authenticated rediss with ssl_cert_reqs=required and the supplied CA.
# MapTiler build input: https://api.maptiler.com/maps/<approved-map>/style.json?key=<restricted-public-key>
# Rendering example only. Copy to a root-readable file outside the repository.
# scripts/release_contract.py deliberately rejects every placeholder below.
ENVIRONMENT=production
LOG_LEVEL=INFO
RELEASE_ID=20260828T120000Z-REPLACE-ME
RELEASE_REVISION=0000000000000000000000000000000000000000
PREVIOUS_RELEASE_ID=
RELEASE_EVIDENCE_SIGNING_SECRET=
RELEASE_EVIDENCE_KEY_ID=EXAMPLE-ONLY-REPLACE-RELEASE-EVIDENCE-KEY-ID
BACKEND_IMAGE=registry.invalid/cardvert/backend@sha256:1111111111111111111111111111111111111111111111111111111111111111
FRONTEND_IMAGE=registry.invalid/cardvert/frontend@sha256:2222222222222222222222222222222222222222222222222222222222222222
POSTGIS_IMAGE=postgis/postgis@sha256:3333333333333333333333333333333333333333333333333333333333333333
REDIS_IMAGE=redis@sha256:4444444444444444444444444444444444444444444444444444444444444444
CADDY_IMAGE=caddy@sha256:5555555555555555555555555555555555555555555555555555555555555555
CLAMAV_IMAGE=clamav/clamav@sha256:6666666666666666666666666666666666666666666666666666666666666666
WEB_CONCURRENCY=2

EDGE_HOSTNAME=cardvert.invalid
PUBLIC_ORIGIN=https://cardvert.invalid
BACKEND_CORS_ORIGINS=[]
SESSION_COOKIE_NAME=__Host-cardvert_session

POSTGRES_PASSWORD=
POSTGRES_TLS_CA_FILE=/secure/REPLACE-ME-postgres-ca.crt
POSTGRES_TLS_CERT_FILE=/secure/REPLACE-ME-postgres-server.crt
POSTGRES_TLS_KEY_FILE=/secure/REPLACE-ME-postgres-server.key
DATABASE_URL=
REDIS_PASSWORD=
REDIS_TLS_CA_FILE=/secure/REPLACE-ME-redis-ca.crt
REDIS_TLS_CERT_FILE=/secure/REPLACE-ME-redis-server.crt
REDIS_TLS_KEY_FILE=/secure/REPLACE-ME-redis-server.key
REDIS_URL=
JWT_SECRET_KEY=
PAYOUT_CRYPTO_KEYRING_B64=
PAYOUT_CRYPTO_KEY_VERSION=1
TRIP_EVIDENCE_SIGNING_KEYRING_B64=
TRIP_EVIDENCE_SIGNING_KEY_VERSION=1

OBJECT_STORAGE_ENDPOINT_URL=https://objects.invalid
OBJECT_STORAGE_PUBLIC_ENDPOINT_URL=https://objects.invalid
OBJECT_STORAGE_REGION=EXAMPLE-ONLY-REPLACE-REGION
OBJECT_STORAGE_BUCKET=EXAMPLE-ONLY-REPLACE-PRIVATE-BUCKET
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

ALLOW_DEMO_SEED=false
DEMO_LOGIN_ENABLED=false
LOGIN_RATE_LIMIT_RELAY_CLIENT_IP_HEADER=true
LOGIN_RATE_LIMIT_TRUST_CLIENT_IP_HEADER=true
LOGIN_RATE_LIMIT_TRUSTED_PROXY_CIDRS=10.255.254.10/32
DRIVER_REGISTRATION_RATE_LIMIT_TRUST_CLIENT_IP_HEADER=false
DRIVER_REGISTRATION_RATE_LIMIT_TRUSTED_PROXY_CIDRS=
F7_SEED_MAX_TRIPS_PER_DAY=2
DEFAULT_CURRENCY=NGN

PING_RETENTION_MONTHS=12
PARTITION_PREMAKE_MONTHS=4

# Development analytics retain aggregation limits and query history. Restore
# legal/privacy and overlap protections before real users (docs/demo-data.md).
# These numeric defaults are not approved pilot values.
PRIVACY_LEGAL_APPROVAL_REFERENCE=
PRIVACY_MIN_VEHICLES_PER_CELL=3
PRIVACY_MIN_RESOLUTION_M=500


INVOICE_ISSUER_EXTERNAL_INPUT_REFERENCE=
# Day rates and targets are set on audited revisions. Proportional in-area pay and daily payouts are fixed in code.
# EXT-PAYMENT-PROVIDER: Paystack stays disabled until the owner supplies a key.
PAYSTACK_SECRET_KEY=
PAYSTACK_CHECKOUT_RETURN_URL=https://cardvert.invalid/advertiser/billing/paystack/return
PHONE_VERIFICATION_TERRAX_NUMBER=+2347074200080
PASSWORD_RESET_PUBLIC_URL=
DRIVER_ACCOUNT_SETUP_PUBLIC_URL=

BACKUP_PASSPHRASE_FILE=/secure/REPLACE-ME-cardvert-backup-passphrase
BACKUP_RETENTION_DAYS=35
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_MAP_STYLE_URL=

# Runtime identity is fixed by the reviewed production topology.
APP_NAME=cardvert-api
API_V1_PREFIX=/api/v1
LOG_FORMAT=json
REQUEST_ID_HEADER=X-Request-ID
JWT_ALGORITHM=HS256

# Storage, scanner, messaging and recovery controls have no hidden live defaults.
MALWARE_SCANNER_HOST=clamav
EMAIL_PROVIDER=EXAMPLE-ONLY-REPLACE-WITH-SMTP
EMAIL_SENDER_ADDRESS=EXAMPLE-ONLY-REPLACE-SENDER-ADDRESS
EMAIL_SENDER_NAME=Cardvert
EMAIL_SMTP_HOST=EXAMPLE-ONLY-REPLACE-SMTP-HOST
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_STARTTLS=true

# Contact and recovery policy values are explicit for live releases.

# Accepted analytics, fraud and payout formula inputs. Change only through their
# versioned product contracts; do not silently inherit application defaults.
PAYOUT_FORMULA_VERSION=payout_v1
PAYOUT_DEFAULT_HOURLY_RATE_NGN=0.0
PAYOUT_DEFAULT_BASE_RATE_PER_KM=0.0
PAYOUT_DEFAULT_BASE_RATE_PER_ACTIVE_HOUR=0.0
PAYOUT_DEFAULT_TARGET_ZONE_BONUS_RATE_PER_KM=0.0
PAYOUT_DEFAULT_BONUS_ZONE_BONUS_RATE_PER_KM=0.0
PAYOUT_DEFAULT_ESTIMATED_IMPRESSION_RATE_PER_1000=0.0
PAYOUT_DEFAULT_LOW_FRAUD_MULTIPLIER=0.90
PAYOUT_DEFAULT_MEDIUM_FRAUD_MULTIPLIER=0.70
PAYOUT_DEFAULT_HIGH_FRAUD_MULTIPLIER=0.25
PAYOUT_DEFAULT_MIN_PAYOUT_PER_TRIP=0.0
PAYOUT_DEFAULT_MAX_PAYOUT_PER_TRIP=
