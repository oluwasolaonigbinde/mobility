APP_NAME=mobility-adtech-api
ENVIRONMENT=local
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://mobility:mobility@db:5432/mobility
REDIS_URL=redis://redis:6379/0
SENTRY_DSN=
# Browser DSN is embedded during `docker compose build frontend`.
NEXT_PUBLIC_SENTRY_DSN=
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID
JWT_SECRET_KEY=change-me-local-development-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
# Synthetic example only. Set explicit versioned AES-256 KEKs; retain old keys until rewrap.
PAYOUT_CRYPTO_KEYRING_B64={"1":"AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8="}
PAYOUT_CRYPTO_KEY_VERSION=1
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=cardvert-private
OBJECT_STORAGE_ACCESS_KEY_ID=cardvert-local
OBJECT_STORAGE_SECRET_ACCESS_KEY=cardvert-local-secret
MALWARE_SCANNER_HOST=localhost
# Synthetic local Mailpit settings. Do not reuse as a production sender or receipt key.
EMAIL_PROVIDER=smtp
EMAIL_SENDER_ADDRESS=no-reply@cardvert.local
EMAIL_SENDER_NAME=Cardvert Local
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_STARTTLS=false
# Day rates and targets are set on audited revisions. Proportional in-area pay and daily payouts are fixed in code.
# EXT-PAYMENT-PROVIDER: Paystack stays disabled until the owner supplies a key.
PAYSTACK_SECRET_KEY=
PAYSTACK_CHECKOUT_RETURN_URL=http://localhost:3000/advertiser/billing/paystack/return
# D117: client Terrax support number, in international format.
PHONE_VERIFICATION_TERRAX_NUMBER=+2347074200080
# Required for production reset emails; local/test may expose a synthetic action only.
PASSWORD_RESET_PUBLIC_URL=http://localhost:3000/reset-password
DRIVER_ACCOUNT_SETUP_PUBLIC_URL=http://localhost:3000/driver-account-setup
PUBLIC_ORIGIN=http://localhost:3000
LOGIN_RATE_LIMIT_TRUST_CLIENT_IP_HEADER=false
DRIVER_REGISTRATION_RATE_LIMIT_GLOBAL_MAX_ATTEMPTS=100
DRIVER_REGISTRATION_RATE_LIMIT_GLOBAL_WINDOW_SECONDS=3600
DRIVER_REGISTRATION_RATE_LIMIT_TRUST_CLIENT_IP_HEADER=false
DRIVER_REGISTRATION_RATE_LIMIT_TRUSTED_PROXY_CIDRS=
# Frontend opt-in for relaying an edge-created X-Client-IP on login only.
LOGIN_RATE_LIMIT_RELAY_CLIENT_IP_HEADER=false
DEMO_LOGIN_ENABLED=false
DEMO_LOGIN_ADVERTISER_EMAIL=
DEMO_LOGIN_ADVERTISER_PASSWORD=
DEMO_LOGIN_DRIVER_EMAIL=
DEMO_LOGIN_DRIVER_PASSWORD=
DEMO_LOGIN_ADMIN_EMAIL=
DEMO_LOGIN_ADMIN_PASSWORD=
# Only enable behind a header-stripping edge; comma-separated BFF peer networks.
LOGIN_RATE_LIMIT_TRUSTED_PROXY_CIDRS=
DEFAULT_CURRENCY=NGN
# External gate reference for the verified legal invoice issuer. Keep blank
# until EXT-Q28-COMPANY is resolved; blank keeps invoice issuance disabled.
INVOICE_ISSUER_EXTERNAL_INPUT_REFERENCE=
# Optional. Omit or set a nonnegative amount to cap default payout rules.
# PAYOUT_DEFAULT_MAX_PAYOUT_PER_TRIP=10000
# Development analytics retain aggregation limits and query history. Restore
# legal/privacy and overlap protections before real users (docs/demo-data.md).
# These numeric defaults are not approved pilot values.
PRIVACY_LEGAL_APPROVAL_REFERENCE=
PRIVACY_MIN_VEHICLES_PER_CELL=3
PRIVACY_MIN_RESOLUTION_M=500
# Comma-separated legal/compliance evidence references that may justify a
# retained-exception DSR outcome. Keep blank until EXT-LEGAL-PRIVACY is supplied.
# Local/demo only. Required for `python -m app.seeds.demo` outside test runs.
ALLOW_DEMO_SEED=false
# Worker sweep cadence; must be a divisor of 60 (1-60) so cron minutes tile the hour.
# Production retention remains disabled until an approved legal value is supplied.
# Q20: required for weekly-floor evaluation; absent values fail closed.
# Data lifecycle (S4): raw ping retention window and partition premake horizon.
PING_RETENTION_MONTHS=12
PARTITION_PREMAKE_MONTHS=4
# Maximum generated trips per rolling assignment/day (default local density).
F7_SEED_MAX_TRIPS_PER_DAY=2
