APP_NAME=mobility-adtech-api
ENVIRONMENT=local
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://mobility:mobility@db:5432/mobility
REDIS_URL=redis://redis:6379/0
SENTRY_DSN=
# Browser DSN is embedded during `docker compose build frontend`.
NEXT_PUBLIC_SENTRY_DSN=
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID
JWT_SECRET_KEY=change-me-local-development-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_ABSOLUTE_LIFETIME_MINUTES=720
LOGIN_RATE_LIMIT_IP_MAX_FAILURES=150
LOGIN_RATE_LIMIT_IP_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_ACCOUNT_MAX_FAILURES=5
LOGIN_RATE_LIMIT_ACCOUNT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_GLOBAL_MAX_FAILURES=250
LOGIN_RATE_LIMIT_GLOBAL_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_TRUST_CLIENT_IP_HEADER=false
# Frontend opt-in for relaying an edge-created X-Client-IP on login only.
LOGIN_RATE_LIMIT_RELAY_CLIENT_IP_HEADER=false
# Only enable behind a header-stripping edge; comma-separated BFF peer networks.
LOGIN_RATE_LIMIT_TRUSTED_PROXY_CIDRS=
PASSWORD_MIN_LENGTH=12
DEFAULT_CURRENCY=NGN
MAX_CAMPAIGN_ZONE_AREA_SQ_KM=5000
MAX_LOCATION_PINGS_PER_BATCH=500
LOCATION_PING_FUTURE_SKEW_SECONDS=300
LOCATION_PING_START_SKEW_SECONDS=900
MAX_LOCATION_ACCURACY_M=10000
MAX_LOCATION_SPEED_MPS=120
ROUTE_ANALYTICS_FORMULA_VERSION=route_analytics_v1
ROUTE_ANALYTICS_MIN_VALID_PINGS=2
ROUTE_ANALYTICS_MOVING_SPEED_MPS=1.0
ROUTE_ANALYTICS_STATIONARY_SPEED_MPS=0.5
ROUTE_ANALYTICS_IMPOSSIBLE_SPEED_MPS=55
ROUTE_ANALYTICS_MAX_PING_GAP_SECONDS=900
ROUTE_ANALYTICS_POOR_ACCURACY_THRESHOLD_M=100
ROUTE_ANALYTICS_POOR_ACCURACY_RATIO_THRESHOLD=0.5
ROUTE_ANALYTICS_STATIONARY_RATIO_THRESHOLD=0.8
ROUTE_ANALYTICS_LOOPING_RADIUS_M=50
ROUTE_ANALYTICS_LOOPING_MIN_DISTANCE_M=1000
IMPRESSION_FORMULA_VERSION=impressions_v1
IMPRESSION_DEFAULT_TRAFFIC_DENSITY_PER_KM=120
IMPRESSION_DEFAULT_DWELL_IMPRESSIONS_PER_MINUTE=3
IMPRESSION_HIGH_FRAUD_MULTIPLIER=0.25
IMPRESSION_MEDIUM_FRAUD_MULTIPLIER=0.70
IMPRESSION_LOW_FRAUD_MULTIPLIER=0.90
IMPRESSION_INSUFFICIENT_DATA_CONFIDENCE=0.10
IMPRESSION_MIN_CONFIDENCE=0.0
IMPRESSION_MAX_CONFIDENCE=1.0
PAYOUT_FORMULA_VERSION=payout_v1
PAYOUT_DEFAULT_BASE_RATE_PER_KM=0
PAYOUT_DEFAULT_BASE_RATE_PER_ACTIVE_HOUR=0
PAYOUT_DEFAULT_TARGET_ZONE_BONUS_RATE_PER_KM=0
PAYOUT_DEFAULT_BONUS_ZONE_BONUS_RATE_PER_KM=0
PAYOUT_DEFAULT_ESTIMATED_IMPRESSION_RATE_PER_1000=0
PAYOUT_DEFAULT_LOW_FRAUD_MULTIPLIER=0.90
PAYOUT_DEFAULT_MEDIUM_FRAUD_MULTIPLIER=0.70
PAYOUT_DEFAULT_HIGH_FRAUD_MULTIPLIER=0.25
PAYOUT_DEFAULT_MIN_PAYOUT_PER_TRIP=0
# Optional. Omit or set a nonnegative amount to cap default payout rules.
# PAYOUT_DEFAULT_MAX_PAYOUT_PER_TRIP=10000
HEATMAP_DEFAULT_RESOLUTION_M=500
HEATMAP_MIN_RESOLUTION_M=50
HEATMAP_MAX_RESOLUTION_M=5000
HEATMAP_MAX_BBOX_AREA_SQ_KM=2500
HEATMAP_MAX_DATE_RANGE_DAYS=90
HEATMAP_MAX_CELLS=5000
HEATMAP_MIN_TRIPS_PER_CELL=1
# Local/demo only. Required for `python -m app.seeds.demo` outside test runs.
ALLOW_DEMO_SEED=false
# Worker sweep cadence; must be a divisor of 60 (1-60) so cron minutes tile the hour.
WORKER_SWEEP_INTERVAL_MINUTES=5
WORKER_SWEEP_BATCH_SIZE=25
# Data lifecycle (S4): raw ping retention window and partition premake horizon.
PING_RETENTION_MONTHS=12
PARTITION_PREMAKE_MONTHS=4
# Maximum generated trips per rolling assignment/day (default local density).
F7_SEED_MAX_TRIPS_PER_DAY=2
